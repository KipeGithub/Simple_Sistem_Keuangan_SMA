{
  "version": 2,
  "functions": {
    "index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/"
    },
    {
      "src": "/excel/(.*)",
      "dest": "/excel/"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}